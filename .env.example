# Directory for JSON table storage. Falls back to an OS temp directory when unwritable (Vercel).
FANTASY_ENGINE_DATA_DIR=./data
# 32+ character passphrase used to derive the AES-256-GCM key that encrypts stored credentials.
CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-long-random-passphrase
# Chromium executable used by the Playwright automation suite. Auto-detected when omitted.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
# Persistent browser profile directory for cookie / MFA sessions.
FANTASY_ENGINE_BROWSER_PROFILE_DIR=./.browser-profiles
# Remote debugging port range start. A free port is picked dynamically from this base.
FANTASY_ENGINE_DEBUG_PORT_BASE=9222
# Upstream API bases (override for proxies or test doubles).
SLEEPER_API_BASE=https://api.sleeper.app/v1
ESPN_API_BASE=https://lm-api-reads.fantasy.espn.com/apis/v3/games/ffl/seasons
YAHOO_API_BASE=https://fantasysports.yahooapis.com/fantasy/v2
YAHOO_CONSUMER_KEY=
YAHOO_CONSUMER_SECRET=
YAHOO_REDIRECT_URI=http://localhost:3000/api/yahoo/oauth/callback
